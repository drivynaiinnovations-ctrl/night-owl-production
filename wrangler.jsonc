{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-owl-production",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "callnightowls.com",
      "custom_domain": true
    },
    {
      "pattern": "www.callnightowls.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "night-owl-requests",
      "database_id": "72700374-8f8a-4382-98d2-a6d5725e05fc",
      "migrations_dir": "migrations"
    }
  ],
  // Optional new-request alerts via Cloudflare Email Routing. Set NOTIFY_TO to a verified destination address.
  "send_email": [{ "name": "NOTIFY" }],
  "vars": {
    "NOTIFY_TO": "",
    "NOTIFY_FROM": "requests@callnightowls.com"
  },
  "observability": {
    "enabled": true
  }
}
